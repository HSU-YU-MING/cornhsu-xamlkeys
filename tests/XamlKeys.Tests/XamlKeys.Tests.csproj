<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XamlKeys.Core\XamlKeys.Core.csproj" />

    <!-- CLI 契約測試以子行程跑真的 xamlkeys.dll：旗標解析與 DecideExit 的判定順序
         只存在於 Program.cs，Core 的單元測試碰不到。
         ReferenceOutputAssembly=false：只確保建置順序，不把 exe 當組件引用。 -->
    <ProjectReference Include="..\..\src\XamlKeys.Cli\XamlKeys.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="XamlKeysCliOutput" />
  </ItemGroup>

  <Target Name="EmbedXamlKeysCliPath" AfterTargets="ResolveProjectReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>XamlKeysCliDll</_Parameter1>
        <_Parameter2>@(XamlKeysCliOutput->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
