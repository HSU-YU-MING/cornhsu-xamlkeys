<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XamlKeys.Core</RootNamespace>
    <!-- 解析引擎：純 System.Xml.Linq，不依賴 WPF runtime —— Linux CI 也能跑。
         C# 側的用法掃描刻意不走 Roslyn，理由見 CSharpScanner.cs 的檔頭。 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XamlKeys.Tests" />
  </ItemGroup>

  <!-- WinUI 框架提供的資源鍵（microsoft/microsoft-ui-xaml，MIT）。
       產生方式見 scripts/regenerate-framework-keys.mjs；授權聲明在 THIRD-PARTY-NOTICES.md。 -->
  <ItemGroup>
    <EmbeddedResource Include="WinUiFrameworkKeys.json" LogicalName="XamlKeys.Core.WinUiFrameworkKeys.json" />
    <EmbeddedResource Include="WpfFluentKeys.json" LogicalName="XamlKeys.Core.WpfFluentKeys.json" />
    <EmbeddedResource Include="AvaloniaFluentKeys.json" LogicalName="XamlKeys.Core.AvaloniaFluentKeys.json" />
    <EmbeddedResource Include="AvaloniaFluent2Keys.json" LogicalName="XamlKeys.Core.AvaloniaFluent2Keys.json" />
    <EmbeddedResource Include="AvaloniaSimpleKeys.json" LogicalName="XamlKeys.Core.AvaloniaSimpleKeys.json" />
    <EmbeddedResource Include="AvaloniaColorPickerKeys.json" LogicalName="XamlKeys.Core.AvaloniaColorPickerKeys.json" />
    <EmbeddedResource Include="AvaloniaDataGridKeys.json" LogicalName="XamlKeys.Core.AvaloniaDataGridKeys.json" />
    <EmbeddedResource Include="AvaloniaTreeDataGridKeys.json" LogicalName="XamlKeys.Core.AvaloniaTreeDataGridKeys.json" />
    <EmbeddedResource Include="CommunityToolkitKeys.json" LogicalName="XamlKeys.Core.CommunityToolkitKeys.json" />
  </ItemGroup>

</Project>
